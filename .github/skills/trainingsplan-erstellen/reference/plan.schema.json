{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "estimatedDurationMin": {
      "type": "integer",
      "minimum": 5,
      "maximum": 180
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "equipment": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "none",
          "dumbbells",
          "barbell",
          "plates",
          "kettlebell",
          "bench",
          "pullup-bar",
          "resistance-band",
          "cable-machine",
          "machine",
          "mat",
          "box",
          "medicine-ball",
          "jump-rope",
          "foam-roller",
          "trx",
          "wall",
          "chair"
        ]
      }
    },
    "targetMuscles": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "chest",
          "upper-back",
          "lats",
          "lower-back",
          "traps",
          "shoulders",
          "rear-delts",
          "biceps",
          "triceps",
          "forearms",
          "abs",
          "obliques",
          "glutes",
          "quads",
          "hamstrings",
          "adductors",
          "calves",
          "full-body",
          "cardio",
          "mobility"
        ]
      }
    },
    "tags": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 30
      }
    },
    "metValue": {
      "default": 4.5,
      "type": "number",
      "minimum": 1,
      "maximum": 15
    },
    "avgHeartRateBpm": {
      "default": 120,
      "type": "integer",
      "minimum": 40,
      "maximum": 220
    },
    "blocks": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "warmup",
              "main",
              "cooldown"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "rounds": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "restBetweenRoundsSec": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 900
          },
          "exercises": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exerciseId": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 60,
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 60
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "reps",
                    "time"
                  ]
                },
                "usesWeight": {
                  "type": "boolean"
                },
                "primaryMuscles": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "chest",
                      "upper-back",
                      "lats",
                      "lower-back",
                      "traps",
                      "shoulders",
                      "rear-delts",
                      "biceps",
                      "triceps",
                      "forearms",
                      "abs",
                      "obliques",
                      "glutes",
                      "quads",
                      "hamstrings",
                      "adductors",
                      "calves",
                      "full-body",
                      "cardio",
                      "mobility"
                    ]
                  }
                },
                "secondaryMuscles": {
                  "default": [],
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "chest",
                      "upper-back",
                      "lats",
                      "lower-back",
                      "traps",
                      "shoulders",
                      "rear-delts",
                      "biceps",
                      "triceps",
                      "forearms",
                      "abs",
                      "obliques",
                      "glutes",
                      "quads",
                      "hamstrings",
                      "adductors",
                      "calves",
                      "full-body",
                      "cardio",
                      "mobility"
                    ]
                  }
                },
                "equipment": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "none",
                      "dumbbells",
                      "barbell",
                      "plates",
                      "kettlebell",
                      "bench",
                      "pullup-bar",
                      "resistance-band",
                      "cable-machine",
                      "machine",
                      "mat",
                      "box",
                      "medicine-ball",
                      "jump-rope",
                      "foam-roller",
                      "trx",
                      "wall",
                      "chair"
                    ]
                  }
                },
                "tempo": {
                  "type": "string",
                  "pattern": "^\\d-\\d-\\d$"
                },
                "cues": {
                  "default": [],
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 90
                  }
                },
                "sets": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reps": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "durationSec": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3600
                      },
                      "targetWeightKg": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 500
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "restSec": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 900
                      },
                      "note": {
                        "type": "string",
                        "maxLength": 120
                      }
                    },
                    "required": [
                      "restSec"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "exerciseId",
                "name",
                "mode",
                "usesWeight",
                "primaryMuscles",
                "sets"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "exercises"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "estimatedDurationMin",
    "level",
    "equipment",
    "targetMuscles",
    "blocks"
  ],
  "additionalProperties": false
}
